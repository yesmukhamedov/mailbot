# Скопируйте в .env — этот файл в git не попадает.
# Здесь лежат только пароли; какие ящики существуют, описано в accounts.json.
#
# Имя переменной задаётся полем passEnv у ящика в accounts.json.
# Для Gmail и Яндекса нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не обычный пароль от аккаунта.

MAILBOT_GMAIL_PASS=xxxxxxxxxxxxxxxx
# MAILBOT_OTHER_PASS=

# Ящикам Microsoft (transport outlook-web) пароль не нужен:
# вход выполняется один раз командой `mailbot login <имя>`.

# Необязательное: путь к другому accounts.json
# MAILBOT_CONFIG=D:\mailbot\accounts.json

# Подробные стектрейсы при ошибках
# MAILBOT_DEBUG=1
